{
  "name": "lint-staged.sh",
  "version": "0.6.5",
  "description": "Run linters against files staged in Git",
  "author": "Iiro Jäppinen <iiro@jappinen.fi> (https://iiro.fi)",
  "license": "MIT",
  "homepage": "https://github.com/lint-staged/lint-staged.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/lint-staged/lint-staged.sh"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "bin": {
    "lint-staged.sh": "lint-staged.sh"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "lint-staged.sh",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "version": "commit-and-tag-version"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "commit-and-tag-version": "12.7.3",
    "husky": "9.1.7",
    "prettier": "3.8.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "keywords": [
    "lint",
    "staged",
    "git",
    "pre_commit",
    "commit",
    "hook",
    "style",
    "quality"
  ]
}
